PanelWidgetClass EntryRow {
 ignorepointer 1
 color 0 0 0 0
 position 0 0
 size 712 30
 hexactpos 1
 vexactpos 1
 hexactsize 1
 vexactsize 1
 style blank
 {
  PanelWidgetClass Chip {
   ignorepointer 1
   color 1 1 1 1
   position 8 5
   size 124 22
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   style VPPFillRound
   {
    TextWidgetClass TxtChip {
     ignorepointer 1
     position 0 0
     size 1 1
     halign center_ref
     valign center_ref
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 0
     style None
     text ""
     font "gui/fonts/sdf_MetronLight72"
     "bold text" 1
     "exact text" 1
     "exact text size" 12
     "size to text h" 1
     "size to text v" 1
     "text halign" center
     "text valign" center
    }
   }
  }
  ImageWidgetClass ImgBullet {
   ignorepointer 1
   color 0.604 0.627 0.651 1
   position 150 13
   size 6 6
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   image0 "set:vpp_icons image:dot"
   mode blend
   "src alpha" 1
   "stretch mode" stretch_w_h
   filter 1
  }
  RichTextWidgetClass TxtBody {
   ignorepointer 1
   color 0.953 0.961 0.969 1
   position 146 4
   size 502 25
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   style None
   text ""
   font "gui/fonts/sdf_MetronLight72"
   "exact text" 1
   "exact text size" 17
   "size to text h" 0
   "size to text v" 1
   wrap 1
  }
 }
}
